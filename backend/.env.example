# Copy this file to backend/.env before running the Django server.

DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Must match the values used in the root .env for docker-compose.
POSTGRES_DB=edtech
POSTGRES_USER=edtech
POSTGRES_PASSWORD=edtech_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

# MinIO (used starting from the documents/RAG phase)
# Runs natively on this machine — start it manually before using the backend:
#   minio.exe server C:\minio-data --console-address ":9001"
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=edtech-documents
MINIO_USE_SSL=False
